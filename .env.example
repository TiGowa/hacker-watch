# Copy to .env and fill in. .env is git-ignored.
# Required: free key from https://pikespeak.ai (API section of your account)
PIKESPEAK_KEY=
# Optional but recommended: FastNEAR API key; without it balance checks hit rate limits
FASTNEAR_API_KEY=
# Optional: trace a different NEAR wallet (defaults to the efd22425… wallet)
# WATCH_ROOT=
